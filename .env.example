# Copy this file to .env (git-ignored) for local builds, or set the same
# names as repository *variables* (not secrets - they end up in the public
# client bundle either way) under GitHub → Settings → Secrets and variables
# → Actions → Variables, so .github/workflows/static.yml can pass them into
# `npm run build`. See README's "跨裝置同步" and "AI 辨識課表照片" sections
# for what each one is for and how to set up the service behind it.

# Firebase project ID that powers cross-device sync (src/sync.js). Baking
# this in lets every user just enter a pairing code - no Firebase project
# of their own required. Leave unset to fall back to each device typing in
# its own project ID (useful for a fork without its own shared project).
VITE_ORBIT_SYNC_PROJECT_ID=

# URL of the deployed Cloudflare Worker proxy (cloudflare-worker/gemini-
# proxy-worker.js), e.g. https://orbit-ai-gemini-proxy.<you>.workers.dev.
# When set, AI schedule-photo import calls this instead of Gemini directly,
# so users never need a Gemini API key of their own. Leave unset to fall
# back to the original bring-your-own-key flow.
VITE_ORBIT_GEMINI_PROXY_URL=
